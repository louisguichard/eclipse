{
  "name": "eclipse-2026",
  "private": true,
  "version": "0.0.0",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "search:cities:build": "python3 scripts/search/build_world_cities.py",
    "lidar:test": "python scripts/lidar/test_visibility_model.py",
    "lidar:generate": "python scripts/lidar/generate_paris_visibility.py",
    "lidar:idf": "python scripts/lidar/generate_idf_visibility.py",
    "lidar:urban-boundaries": "python scripts/lidar/prepare_urban_unit_boundaries.py",
    "lidar:urban-units": "python scripts/lidar/generate_urban_units_visibility.py",
    "lidar:export-regions": "python3 scripts/lidar/export_visibility_regions.py",
    "lidar:export-regions:check": "python3 scripts/lidar/export_visibility_regions.py --check",
    "r2:test": "python3 scripts/r2/test_publish_visibility.py",
    "r2:plan": "python3 scripts/r2/publish_visibility.py --plan",
    "r2:publish": "python3 scripts/r2/publish_visibility.py",
    "r2:verify": "python3 scripts/r2/verify_visibility_cdn.py",
    "r2:basemap:plan": "python3 scripts/r2/publish_basemap.py --plan",
    "r2:basemap:publish": "python3 scripts/r2/publish_basemap.py",
    "check": "npm run typecheck && npm run lint && npm test && npm run build",
    "preview": "vite preview"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/schibsted-grotesk": "^5.3.0",
    "@protomaps/basemaps": "^5.7.2",
    "astronomy-engine": "^2.1.19",
    "lucide-react": "^1.30.0",
    "maplibre-gl": "^6.3.0",
    "pmtiles": "^4.5.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "@vitest/coverage-v8": "^4.1.10",
    "jsdom": "^29.1.1",
    "oxlint": "^1.75.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.2.0",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.10"
  }
}

# Fond de carte sans clé. OpenFreeMap convient au lancement, sans garantie de
# service. Vérifiez et conservez son attribution.
VITE_BASEMAP_STYLE_URL=https://tiles.openfreemap.org/styles/dark

# Facultatif : archive Protomaps auto-hébergée. Elle prend le pas sur le style
# public ci-dessus et permet de maîtriser totalement le trafic cartographique.
VITE_BASEMAP_PMTILES_URL=

# Facultatif : CDN contenant le dossier versionné paris-2026-max-v1.
# Laisser vide pour servir les tuiles incluses dans public/visibility/.
VITE_VISIBILITY_TILE_BASE_URL=

# Temporaire : clé WeatherAPI.com injectée dans le bundle client et donc
# publiquement récupérable. Utiliser une clé jetable et la révoquer après l’événement.
VITE_WEATHERAPI_KEY=

# Facultatif : identifiant public du site Cloudflare Web Analytics.
# Le beacon n'est chargé qu'en build de production lorsqu'un token est présent.
VITE_CLOUDFLARE_WEB_ANALYTICS_TOKEN=

# Facultatif : DSN public du projet Sentry. Les erreurs ne sont envoyées qu'en
# production ; tracing, replay, logs et collecte de données utilisateur restent désactivés.
VITE_SENTRY_DSN=

# Affiche le bandeau de maintenance orange. Modifier la valeur puis redéployer.
VITE_MAINTENANCE_BANNER_ENABLED=false

# Pourcentage stable de navigateurs auxquels proposer Speakea (0 à 100).
# Modifier la valeur puis redéployer. La valeur par défaut est 100.
VITE_SPEAKEA_BANNER_PERCENTAGE=100

# Masque l’écran d’adieu affiché depuis l’éclipse (photographie et
# « C’est terminé »). Il est actif par défaut : passer la valeur à `true`
# sert directement le site, puis redéployer.
VITE_FAREWELL_DISABLED=false

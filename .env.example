# Clé navigateur Google Maps Platform — ne placez jamais une vraie clé ici.
VITE_GOOGLE_MAPS_API_KEY=replace_with_your_restricted_browser_key

# Facultatif : Map ID JavaScript pour un style administré dans Google Cloud.
VITE_GOOGLE_MAP_ID=

# Facultatif : CDN contenant le dossier versionné paris-2026-max-v1.
# Laisser vide pour servir les tuiles incluses dans public/visibility/.
VITE_VISIBILITY_TILE_BASE_URL=

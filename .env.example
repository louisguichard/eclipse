# Seule clé Google utilisée : Maps Embed API pour le panorama Street View.
# Restreignez-la à cette API et aux référents exacts du site.
VITE_GOOGLE_MAPS_EMBED_API_KEY=replace_with_your_restricted_embed_key

# Fond de carte. Pour démarrer, l'application utilise le style public gratuit
# OpenFreeMap. Définissez cette URL pour choisir un autre style MapLibre.
VITE_BASEMAP_STYLE_URL=https://tiles.openfreemap.org/styles/dark

# Cible recommandée en production : archive Protomaps auto-hébergée sur R2.
# Lorsqu'elle est définie, elle est prioritaire sur VITE_BASEMAP_STYLE_URL.
VITE_BASEMAP_PMTILES_URL=

# Facultatif : CDN contenant le dossier versionné paris-2026-max-v1.
# Laisser vide pour servir les tuiles incluses dans public/visibility/.
VITE_VISIBILITY_TILE_BASE_URL=

# Facultatif : identifiant public du site Cloudflare Web Analytics.
# Le beacon n'est chargé qu'en build de production lorsqu'un token est présent.
VITE_CLOUDFLARE_WEB_ANALYTICS_TOKEN=

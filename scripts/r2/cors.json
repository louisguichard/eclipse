{
  "rules": [
    {
      "allowed": {
        "origins": [
          "https://eclipse.louisguichard.fr",
          "http://localhost:5173"
        ],
        "methods": [
          "GET",
          "HEAD"
        ],
        "headers": [
          "Range"
        ]
      },
      "exposeHeaders": [
        "Accept-Ranges",
        "Content-Length",
        "Content-Range",
        "ETag"
      ],
      "maxAgeSeconds": 7200
    }
  ]
}
